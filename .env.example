# Linear API — OPTIONAL.
# Leave blank for local-only mode (create tasks via the /new-task page instead).
# See docs/SELF-HOSTED-LOCAL.md
LINEAR_API_KEY=

# Anthropic API — only needed if you run the headless agent executor.
# Get your API key from: https://console.anthropic.com/settings/keys
# Add API credits (not subscription) at: https://console.anthropic.com/settings/billing
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Convex ───────────────────────────────────────────────────────────────
# OPTION A — Self-hosted local (Docker). See docs/SELF-HOSTED-LOCAL.md
#   docker compose up -d
#   docker compose exec convex-backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# OPTION B — Convex Cloud (run `npx convex dev` to populate these instead)
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
